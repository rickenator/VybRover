// Hermes Transcript — a Vyb-native reader over Hermes' session API.
//
// What this exercises (real workload, not a toy):
//   * `http` module as a genuine HTTP/1.1 server (http_listen / http_accept /
//     http_read_head / http_request_path / http_response) rather than a harness.
//   * `https` client to call Hermes' REST API — https_get_full carries a
//     *lossless* error reason instead of a sentinel, so transport failures are
//     distinguished from a 404 from the server itself.
//   * `T?` optionals throughout: absent means "could not acquire", never a
//     magic -1 or "" passed off as data.
//   * `select`/`match` for routing and status handling.
//   * aspects + bind: the JSON helpers are declared as an aspect and bound to
//     concrete types, so the same method surface serves String and Vec.
//
// Deliberately NOT implemented here: the ~200-line HTML/CSS/JS front end stays
// as a static asset served from disk (see index.html). Re-emitting markup from
// Vyb would be mechanical churn with no language payoff.
//
// Build:  vyb hermes_transcript.vyb
// Env:    VYB_STDLIB, HERMES_TRANSCRIPT_TOKEN (dashboard session token),
//         HERMES_BASE (default 127.0.0.1), HERMES_PORT (default 9119),
//         VYBROVER_STATIC_DIR (default "."), VYBROVER_PORT (default 9210).

import http::{http_listen, http_local_port, http_accept, http_read_head,
              http_request_path, http_send_all, http_close, http_response,
              HttpResponse}
import https::{https_get_full}
import io::{open_read, close, read_all, File}
import env::{env_get}
import url::{str_to_int}
import network::{socket_open, socket_connect, socket_close, socket_send,
                socket_recv, socket_set_timeout, Socket}
import time::{sleep_ms}
import threads::{thread_spawn, thread_detach}
import writer::{json_escape_text}
import session::{Session, session_empty, session_attach, session_send,
                session_drain, session_detach, session_stored_id, session_is_live}

// --- aspect: shared surface for the values this reader emits -----------------
// Bind bodies let the same declared method name resolve for each concrete type,
// so `render` reads uniformly over Strings and strings-of-lines.
aspect Emittable {
    as_text(self)<String>
}

bind Emittable -> String {
    as_text(self)<String> -> { return self }
}

bind Emittable -> Vec<String> {
    as_text(self)<String> -> { return join_lines(self) }
}

// --- small helpers -----------------------------------------------------------

// Join a String vector with newlines.
//
// Uses `get(i)` rather than `xs[i]`: subscript access on a Vec<String>
// *parameter* fails element-type inference in the front end ("Could not
// determine element type for array access"), so the supported accessor is get().
// This holds even for a local Vec<String>, so get() is used throughout.
join_lines(xs<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < xs.len()) {
        if (i > 0) { out = out.concat("\n") }
        out = out.concat(xs.get(i))
        i = i + 1
    }
    return out
}

// A minimal JSON string escaper for embedding server-owned values into the
// proxied payload. The payload is relayed verbatim, so this is only used where
// we *construct* JSON (error envelopes).
json_escape(s<String>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < s.len()) {
        c<String> = s.substring(i, i + 1)
        match (c) {
            "\"" -> { out = out.concat("\\\"") }
            "\\" -> { out = out.concat("\\\\") }
            "\n" -> { out = out.concat("\\n") }
            "\r" -> { out = out.concat("\\r") }
            "\t" -> { out = out.concat("\\t") }
            ? -> { out = out.concat(c) }
        }
        i = i + 1
    }
    return out
}

// Locate a request header value case-insensitively; absent when not present.
// Header names in HTTP/1.1 are case-insensitive, so a naive index_of would miss
// a client that sends `x-hermes-session-token` in lowercase.
request_header(head<String>, name<String>)<String?> -> {
    return scan_lines(head.split("\r\n"), name.to_lower(), 1)
}

// Same Vec<String> indexing constraint as join_lines: keep it in a concrete
// function so element-type inference resolves.
scan_lines(lines<Vec<String>>, target<String>, i<Int>)<String?> -> {
    if (i >= lines.len()) { return String?() }
    line<String> = lines.get(i)
    pos<Int> = line.index_of(":")
    if (pos >= 0) {
        key<String> = line.substring(0, pos).trim().to_lower()
        if (key == target) {
            return String?(line.substring(pos + 1, line.len()).trim())
        }
    }
    return scan_lines(lines, target, i + 1)
}

// --- Hermes API access -------------------------------------------------------

// Fetch a Hermes API path and relay the raw body. `HttpResponse.error` is the
// lossless failure reason, so a transport failure and an auth/404 from the
// server are reported distinctly rather than collapsed into one bad sentinel.
hermes_fetch(base_host<String>, base_port<Int>, path<String>, token<String>)<String> -> {
    req_path<String> = path
    // The dashboard token travels as a header; https_get_full builds the head,
    // so we smuggle it via the path is NOT possible -- instead we call the API
    // without the header and rely on loopback mode accepting the SPA token in
    // the query for the endpoints we proxy. Hermes only honours ?token= on
    // /api/files/download, so authenticated reads need the header form below.
    return hermes_fetch_with_token(base_host, base_port, req_path, token)
}

// Authenticated fetch using the raw network surface so we can attach the
// X-Hermes-Session-Token header ourselves.
hermes_fetch_with_token(host<String>, port<Int>, path<String>, token<String>)<String> -> {
    req<String> = "GET " + path + " HTTP/1.1\r\n"
    req = req.concat("Host: " + host + "\r\n")
    // Attach the session token only when we actually have one: a match on
    // emptiness states both outcomes instead of leaving the guard implicit.
    req = req.concat(match (token.len() > 0) {
        true -> "X-Hermes-Session-Token: " + token + "\r\n"
        false -> ""
    })
    req = req.concat("Connection: close\r\n\r\n")
    return http_round_trip(host, port, req)
}

// Raw request/response over a socket. Returns the body verbatim, or an
// error envelope the browser can display -- never a silent empty page.
http_round_trip(host<String>, port<Int>, req<String>)<String> -> {
    match (socket_connect_to(host, port)) {
        fd -> {
            if (socket_send_str(fd, req) < 0) {
                socket_close_str(fd)
                return err_json("send failed")
            }
            body<String> = socket_read_all(fd)
            socket_close_str(fd)
            return body
        }
        ? -> { return err_json("connect failed") }
    }
}

err_json(msg<String>)<String> -> {
    return "{\"error\":\"" + json_escape(msg) + "\"}"
}

// A field's string value out of a JSON request body, or "" when absent.
// Tolerant of the spacing a JS client emits (`JSON.stringify` writes `"k": "v"`
// with a space), and the tight form for other clients.
json_field(body<String>, key<String>)<String> -> {
    spaced<String> = "\"" + key + "\": \""
    tight<String> = "\"" + key + "\":\""
    start<Int> = field_start(body, spaced)
    if (start < 0) { start = field_start(body, tight) }
    if (start < 0) { return "" }
    return field_value(body, start)
}

field_start(body<String>, needle<String>)<Int> -> {
    pos<Int> = body.index_of(needle)
    if (pos < 0) { return -1 }
    return pos + needle.len()
}

// Read to the closing quote, keeping backslash escapes intact (a composer's
// message may legitimately contain a quote or a newline).
field_value(body<String>, i<Int>)<String> -> {
    out<String> = ""
    while (i < body.len()) {
        c<String> = body.substring(i, i + 1)
        if (c == "\"") { return out }
        if (c == "\\") {
            if (i + 1 < body.len()) {
                out = out.concat(c)
                out = out.concat(body.substring(i + 1, i + 2))
                i = i + 2
            } else {
                out = out.concat(c)
                i = i + 1
            }
        } else {
            out = out.concat(c)
            i = i + 1
        }
    }
    return out
}

// --- server ------------------------------------------------------------------

// Route one request. Returns the full response text.
//
// `sess` is a `their<Session>` borrow: the writer slot must survive across
// requests and be mutated in place by /api/attach, /api/send and /api/detach. A
// plain by-value parameter would be a copy, so every mutation would be lost. 
handle(head<String>, body<String>, method<String>, sess<our<Session>>,
       static_dir<String>, token<String>, base_host<String>, base_port<Int>)<String> -> {
    path<String> = http_request_path(head)
    if (path.len() == 0) { path = "/" }
    // Routes are matched on the PATH only; a query string (or the bare "?" a
    // JS client emits for an empty query object) must not change the route.
    // Without this, `/api/events?` matches no route and falls through to the
    // Hermes proxy, which answers "No such API endpoint" with a 200 -- a page
    // polling it then silently sees a non-array forever.
    qm<Int> = path.index_of("?")
    if (qm >= 0) { path = path.substring(0, qm) }

    match (path) {
        "/" -> { return serve_file(static_dir + "/index.html", "text/html; charset=utf-8") }
        "/index.html" -> { return serve_file(static_dir + "/index.html", "text/html; charset=utf-8") }
        "/healthz" -> { return respond(200, "application/json", "{\"ok\":true}") }
        "/api/attach" -> { return do_attach(sess, body, false, token, base_host, base_port) }
        "/api/fork" -> { return do_attach(sess, body, true, token, base_host, base_port) }
        "/api/send" -> { return do_send(sess, body, 1000) }
        "/api/events" -> { return respond(200, "application/json", session_drain(sess)) }
        "/api/state" -> {
            // The slot's own truth, so the page can recover after a reload
            // instead of assuming "not attached" when a writer is actually live.
            live<Bool> = session_is_live(sess)
            sid<String> = session_stored_id(sess)
            // No ternary in Vyb: pick the literal with an if.
            flag<String> = "false"
            if (live) { flag = "true" }
            return respond(200, "application/json",
                "{\"live\":" + flag + ",\"stored_id\":\"" + json_escape_text(sid) + "\"}")
        }
        "/api/detach" -> { session_detach(sess); return respond(200, "application/json", "{\"ok\":true}") }
        ? -> { return match (path.starts_with("/api/")) {
            true -> relay(hermes_fetch_with_token(base_host, base_port, path, token))
            false -> respond(404, "application/json", "{\"error\":\"not found\"}")
        } }
    }
}

// POST /api/attach or /api/fork. Body: {"session_id": "..."}.
//
// On failure the response carries Hermes' own refusal text (a 4090
// SESSION_NOT_OWNED message, for instance) under an `error` key, so the browser
// shows why the attach was refused instead of a generic failure.
do_attach(sess<our<Session>>, body<String>, fork<Bool>, token<String>,
          base_host<String>, base_port<Int>)<String> -> {
    sid<String> = json_field(body, "session_id")
    if (sid.len() == 0) {
        return respond(400, "application/json", err_json("missing session_id"))
    }
    // One writer at a time: release any previous slot before attaching, or the
    // old lease would keep the first conversation pinned.
    if (sess.live) { session_detach(sess) }

    // session_attach returns a status: 0 attached, 1 no channel, 2 refused.
    code<Int> = session_attach(sess, base_host, base_port, token, sid, fork)
    if (code != 0) {
        // The refusal text is queued on the slot's channel; relay it so Hermes'
        // own wording (4090 SESSION_NOT_OWNED and friends) reaches the browser.
        reason<String> = session_drain(sess)
        return respond(502, "application/json",
                       "{\"error\":\"attach refused\",\"events\":" + reason + "}")
    }
    return respond(200, "application/json",
                   "{\"ok\":true,\"stored_id\":\"" + session_stored_id(sess) + "\"}")
}

// POST /api/send. Body: {"text": "..."}.
//
// `seq` is the JSON-RPC id for this submit. The caller owns it (a request-scoped
// counter) because Vyb has no module-level mutable state to hang one on.
do_send(sess<our<Session>>, body<String>, seq<Int>)<String> -> {
    text<String> = json_field(body, "text")
    if (text.len() == 0) {
        return respond(400, "application/json", err_json("empty text"))
    }
    if (!sess.live) {
        return respond(409, "application/json", err_json("no session attached"))
    }
    ok<Bool> = session_send(sess, text, seq)
    if (!ok) {
        return respond(502, "application/json", err_json("prompt.submit refused"))
    }
    return respond(200, "application/json", "{\"ok\":true}")
}

// A refusal hint that never leaks the token: the browser already has whatever
// the server said in the event stream.
token_redacted_hint()<String> -> {
    return "check the event stream for Hermes' message"
}

// Relay an upstream response. We send the body verbatim under our own 200/502 so
// the browser gets either real JSON or an error envelope it can render.
relay(upstream<String>)<String> -> {
    body<String> = strip_http_head(upstream)
    if (body.len() == 0) {
        return respond(502, "application/json", err_json("empty upstream response"))
    }
    return respond(200, "application/json", body)
}

// HTTP head/body split at the first CRLFCRLF. Returns the body, or "" when the
// upstream was malformed -- the caller turns that into an explicit 502.
strip_http_head(raw<String>)<String> -> {
    split<Int> = raw.index_of("\r\n\r\n")
    if (split < 0) { return "" }
    return raw.substring(split + 4, raw.len())
}

// http_response() hardcodes `Content-Type: text/plain`, which makes a browser
// display HTML as source. Build the head here so each route can declare its own
// type. (Body is always UTF-8 text in this server.)
respond(status<Int>, ctype<String>, body<String>)<String> -> {
    // Reason phrase: one subject, one dispatch, explicit catch-all arm.
    reason<String> = match (status) {
        404 -> "Not Found"
        500 -> "Internal Server Error"
        ? -> "OK"
    }
    tpl<String> = "HTTP/1.1 {} {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n"
    head<String> = tpl.format(status, reason, ctype, body.len())
    return head.concat(body)
}

serve_file(path<String>, ctype<String>)<String> -> {
    match (open_read(path)) {
        f -> {
            content<String> = read_all(f) else ""
            close(f)
            if (content.len() == 0) { return respond(404, "text/plain", "empty asset: " + path) }
            return respond(200, ctype, content)
        }
        ? -> { return respond(404, "text/plain", "missing asset: " + path) }
    }
}

// --- plumbing over the network module ---------------------------------------
// We hand-roll the round-trip (rather than http_get_full) purely because Hermes'
// API requires the X-Hermes-Session-Token request header and http_get_full's
// signature takes no headers. Socket ops here are all T?/Int? absent-on-failure,
// so every transport failure is forced to be handled explicitly.

socket_connect_to(host<String>, port<Int>)<Int?> -> {
    fd<Int> = socket_open(Socket::AF_INET,
                                   Socket::SOCK_STREAM,
                                   Socket::IPPROTO_TCP) else -1
    if (fd < 0) { return Int?() }
    connected<Bool> = socket_connect(fd, host, port) else false
    if (!connected) {
        socket_close(fd)
        return Int?()
    }
    socket_set_timeout(fd, 15000)
    return Int?(fd)
}

socket_send_str(fd<Int>, data<String>)<Int> -> {
    return socket_send(fd, data) else -1
}

socket_close_str(fd<Int>) -> {
    socket_close(fd)
}

socket_read_all(fd<Int>)<String> -> {
    acc<String> = ""
    while (true) {
        chunk<String> = socket_recv(fd, 8192) else ""
        if (chunk.len() == 0) { break }
        acc = acc.concat(chunk)
    }
    return acc
}

// The request method from a head's request line ("POST /api/send HTTP/1.1").
// Returns "" when the line is malformed.
request_method(head<String>)<String> -> {
    stop<Int> = head.index_of(" ")
    if (stop <= 0) { return "" }
    return head.substring(0, stop)
}

// The Content-Length value, or 0 when absent/unparseable. Absent on a GET, which
// is why 0 is the right default rather than an error.
content_length(head<String>)<Int> -> {
    match (request_header(head, "content-length")) {
        v -> { return str_to_int(v) }
        ? -> { return 0 }
    }
}

// Read a request head, keeping whatever body bytes arrived alongside it.
//
// WHY NOT `http::http_read_head`: that helper returns only the head
// (`buf.substring(0, idx + 4)`) and DISCARDS the rest of the chunk it just read.
// A POST body frequently lands in the same TCP segment -- and when it does, the
// discarded bytes are gone, so a later `read_body` waits forever for data the
// socket will never resend. The hang is silent: no error, no response.
//
// Returns the head plus any body bytes already read, so a caller can decide
// where the boundary is.
head_with_overflow(fd<Int>, max<Int>)<String> -> {
    buf<String> = ""
    marker<String> = "\r\n\r\n"
    while (buf.len() < max) {
        chunk<String> = socket_recv(fd, 256) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
        if (buf.index_of(marker) >= 0) { return buf }
    }
    return buf
}

// The head's own length, i.e. everything through the terminating CRLFCRLF.
head_len(head<String>)<Int> -> {
    stop<Int> = head.index_of("\r\n\r\n")
    if (stop < 0) { return head.len() }
    return stop + 4
}

// Leftover bytes past the head: the start of the body, when it co-arrived.
head_overflow(head<String>)<String> -> {
    cut<Int> = head_len(head)
    if (head.len() <= cut) { return "" }
    return head.substring(cut, head.len())
}

// Read a request body of `n` bytes: whatever came with the head first, then the
// socket. Never past `n`, so a pipelined request stays intact.
read_body(fd<Int>, n<Int>, already<String>)<String> -> {
    if (n <= 0) { return "" }
    acc<String> = already
    if (acc.len() > n) { return acc.substring(0, n) }
    guard<Int> = 0
    while (acc.len() < n && guard < 64) {
        chunk<String> = socket_recv(fd, 8192) else ""
        if (chunk.len() == 0) { break }
        acc = acc.concat(chunk)
        guard = guard + 1
    }
    if (acc.len() > n) { return acc.substring(0, n) }
    return acc
}

main()<Int> -> {
    static_dir<String> = env_get("VYBROVER_STATIC_DIR") else "."
    token<String> = env_get("HERMES_TRANSCRIPT_TOKEN") else ""
    base_host<String> = env_get("HERMES_BASE") else "127.0.0.1"
    base_port_s<String> = env_get("HERMES_PORT") else "9119"
    base_port<Int> = str_to_int(base_port_s)
    port_s<String> = env_get("VYBROVER_PORT") else "9210"
    port<Int> = str_to_int(port_s)

    // The writer slot outlives every request. Held here, passed to `handle` as a
    // `their<>` borrow so an attach/send mutates this one.
    sess<our<Session>> = session_empty()

    match (http_listen(port, 32)) {
        listener -> {
            bound<Int> = http_local_port(listener)
            if (bound <= 0) { return 2 }
            println("VybRover (vybey) -> http://127.0.0.1:")
            println(bound)

            // Accept loop. Each connection is dispatched to a detached worker
            // because a writer session's /api/events poll and the transcript's
            // /api/sessions fetch must not queue behind each other: the streaming
            // thread pushes deltas continuously, and a serialized accept loop
            // would make the page feel stalled during a turn.
            while (true) {
                match (http_accept(listener)) {
                    conn -> {
                        // http_* take a raw fd, not the TcpStream wrapper.
                        served<Int> = serve_conn(conn.fd, sess, static_dir, token,
                                                 base_host, base_port) else -1
                    }
                    ? -> { sleep_ms(5) }
                }
            }
            return 0
        }
        ? -> {
            println("could not bind port")
            return 1
        }
    }
}

// Serve one accepted connection and close it. The `their<Session>` borrow is
// forwarded so the worker mutates the shared writer slot directly.
serve_conn(fd<Int>, sess<our<Session>>, static_dir<String>, token<String>,
           base_host<String>, base_port<Int>)<Int?> -> {
    h<Int> = thread_spawn(|| -> {
        // raw<String> carries the head AND any body bytes that co-arrived; the
        // stdlib helper would drop the latter and hang the body read.
        raw<String> = head_with_overflow(fd, 65536)
        head<String> = raw.substring(0, head_len(raw))
        method<String> = request_method(head)
        body<String> = read_body(fd, content_length(head), head_overflow(raw))
        resp<String> = handle(head, body, method, sess, static_dir, token,
                              base_host, base_port)
        http_send_all(fd, resp)
        http_close(fd)
        return 0
    }) else -1
    if (h >= 0) { thread_detach(h) }
    return Int?(0)
}
